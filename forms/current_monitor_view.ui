<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>CurrentMonitorView</class>
 <widget class="QWidget" name="CurrentMonitorView">
  <property name="minimumSize"><size><width>720</width><height>480</height></size></property>
  <layout class="QHBoxLayout" name="horizontalLayout" stretch="0,1">
   <property name="leftMargin"><number>12</number></property>
   <property name="topMargin"><number>12</number></property>
   <property name="rightMargin"><number>12</number></property>
   <property name="bottomMargin"><number>12</number></property>
   <property name="spacing"><number>10</number></property>
   <item>
    <layout class="QVBoxLayout" name="controlLayout">
     <property name="spacing"><number>10</number></property>
     <item>
      <widget class="QGroupBox" name="groupAcquisition">
       <property name="title"><string>Acquisition</string></property>
       <layout class="QFormLayout" name="formAcquisition">
        <item row="0" column="0"><widget class="QLabel" name="labelMode"><property name="text"><string>Mode:</string></property><property name="buddy"><cstring>comboMode</cstring></property></widget></item>
        <item row="0" column="1">
         <widget class="QComboBox" name="comboMode">
          <item><property name="text"><string>IIR polling</string></property></item>
          <item><property name="text"><string>Scope DMA</string></property></item>
         </widget>
        </item>
        <item row="1" column="0"><widget class="QLabel" name="labelTime"><property name="text"><string>Time [s]:</string></property><property name="buddy"><cstring>spinTime</cstring></property></widget></item>
        <item row="1" column="1">
         <widget class="QSpinBox" name="spinTime">
          <property name="toolTip"><string>Stops the acquisition automatically after this many seconds of host time; 0 runs until stopped.</string></property>
          <property name="minimum"><number>0</number></property>
          <property name="maximum"><number>360000</number></property>
         </widget>
        </item>
        <item row="2" column="0"><widget class="QLabel" name="labelSeriesRuns"><property name="text"><string>Repeats:</string></property><property name="buddy"><cstring>spinSeriesRuns</cstring></property></widget></item>
        <item row="2" column="1">
         <widget class="QSpinBox" name="spinSeriesRuns">
          <property name="enabled"><bool>false</bool></property>
          <property name="toolTip"><string>Number of runs one Start performs; check Settings &gt; Enable Series to use it.</string></property>
          <property name="minimum"><number>1</number></property>
          <property name="maximum"><number>9999</number></property>
          <property name="value"><number>1</number></property>
         </widget>
        </item>
        <item row="3" column="0" colspan="2">
         <layout class="QHBoxLayout" name="layoutRunButtons">
          <item><widget class="QPushButton" name="btnStart"><property name="text"><string>Start monitor</string></property><property name="nlabRole" stdset="0"><string notr="true">start</string></property></widget></item>
          <item><widget class="QPushButton" name="btnStop"><property name="text"><string>Stop</string></property><property name="enabled"><bool>false</bool></property><property name="nlabRole" stdset="0"><string notr="true">stop</string></property></widget></item>
         </layout>
        </item>
        <item row="4" column="0" colspan="2">
         <widget class="QPushButton" name="btnResetScopeDefaults">
          <property name="text"><string>Reset Scope defaults</string></property>
          <property name="enabled"><bool>false</bool></property>
          <property name="toolTip"><string>Restore the Scope hardware defaults after stopping Current DMA.</string></property>
         </widget>
        </item>
        <item row="5" column="0" colspan="2">
         <widget class="QCheckBox" name="cbPauseReadbacks">
          <property name="text"><string>Pause readbacks</string></property>
          <property name="toolTip"><string>Pause MCA, HV and temperature readbacks during capture. While this Current acquisition runs, pause MCA histogram/statistics, Power Supply (HV and temperature) and Global diagnostics polling on all channels, so they do not compete with the capture on the board. Measurements and HV setpoints are unaffected; displays update again when Current stops. Temperature correction holds its last applied value while paused.</string></property>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="sumTimingControls">
       <property name="title"><string>Timing</string></property>
       <layout class="QFormLayout" name="formSumTiming">
        <item row="0" column="0"><widget class="QLabel" name="labelSumSamples"><property name="text"><string>Window size:</string></property><property name="buddy"><cstring>spinSumSamples</cstring></property></widget></item>
        <item row="0" column="1">
         <widget class="QSpinBox" name="spinSumSamples">
          <property name="toolTip"><string>ADC samples integrated per sum window: 4 to 8188, in steps of 4. Each sample lasts 2 ns. This sets the next capture, not the fixed 4096-byte packet size.</string></property>
          <property name="suffix"><string> samples</string></property>
          <property name="minimum"><number>4</number></property>
          <property name="maximum"><number>8188</number></property>
          <property name="singleStep"><number>4</number></property>
          <property name="value"><number>1024</number></property>
         </widget>
        </item>
        <item row="1" column="0"><widget class="QLabel" name="labelDmaGap"><property name="text"><string>DMA gap:</string></property><property name="enabled"><bool>false</bool></property><property name="buddy"><cstring>spinDmaGap</cstring></property></widget></item>
        <item row="1" column="1">
         <widget class="QDoubleSpinBox" name="spinDmaGap">
          <property name="enabled"><bool>false</bool></property>
          <property name="toolTip"><string>Post-frame gap for the next Scope DMA current measurement; hardware resolution is 0.008 microseconds.</string></property>
          <property name="suffix"><string> &#xB5;s</string></property>
          <property name="decimals"><number>3</number></property>
          <property name="minimum"><double>0.000000000000000</double></property>
          <property name="maximum"><double>524.280000000000000</double></property>
          <property name="singleStep"><double>0.008000000000000</double></property>
          <property name="value"><double>100.000000000000000</double></property>
         </widget>
        </item>
        <item row="2" column="0" colspan="2"><widget class="QLabel" name="labelSumTiming"><property name="text"><string/></property><property name="wordWrap"><bool>true</bool></property><property name="toolTip"><string>Window duration is N times 2 ns. Scheduled start interval is the window duration plus the window gap; missed windows are excluded from measured exposure.</string></property></widget></item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="sumControls">
       <property name="title"><string>Recording</string></property>
       <layout class="QFormLayout" name="formSumRecording">
        <item row="0" column="0"><widget class="QCheckBox" name="cbRecordSums"><property name="text"><string>Record</string></property><property name="toolTip"><string>Record the original sum packets to a new file, in the selected format.</string></property></widget></item>
        <item row="0" column="1">
         <widget class="QComboBox" name="comboSumFormat">
          <property name="toolTip"><string>Binary (.bin): the packets exactly as received, about a third of the size, and about ten times cheaper to write; use it for windows shorter than 448 ns. HDF5 (.h5): also stores decoded timestamp and sum columns and opens in generic HDF5 tools. Current Capture Analysis opens both.</string></property>
          <item><property name="text"><string>Binary (.bin)</string></property></item>
          <item><property name="text"><string>HDF5 (.h5)</string></property></item>
         </widget>
        </item>
        <item row="1" column="0" colspan="2">
         <layout class="QHBoxLayout" name="layoutSumFile">
          <item><widget class="QLineEdit" name="editSumFile"><property name="placeholderText"><string>Automatic filename on Start</string></property><property name="toolTip"><string>Leave blank for chN_current_&lt;timestamp&gt; with the selected format's extension on Start. A .bin, .h5 or .hdf5 extension selects that format. Relative filenames use the measurement folder from General Settings. Existing files require overwrite confirmation, unless General Settings adds the start time to chosen names (then an existing file is never replaced).</string></property></widget></item>
          <item><widget class="QPushButton" name="btnSumFile"><property name="text"><string>Browse…</string></property><property name="toolTip"><string>Choose a sum recording file, starting in the measurement folder from General Settings.</string></property></widget></item>
         </layout>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="groupCalibration">
       <property name="title"><string>Linear calibration</string></property>
       <layout class="QFormLayout" name="formCalibration">
        <item row="0" column="0"><widget class="QLabel" name="labelZero"><property name="text"><string>Zero code:</string></property><property name="buddy"><cstring>spinZero</cstring></property></widget></item>
        <item row="0" column="1">
         <layout class="QHBoxLayout" name="layoutZero">
          <item>
           <widget class="QDoubleSpinBox" name="spinZero">
            <property name="decimals"><number>3</number></property>
            <property name="minimum"><double>-32768.000000000000000</double></property>
            <property name="maximum"><double>32767.000000000000000</double></property>
            <property name="singleStep"><double>1.000000000000000</double></property>
           </widget>
          </item>
          <item><widget class="QPushButton" name="btnZero"><property name="text"><string>Set zero</string></property><property name="toolTip"><string>Set the zero code from the mean of recent samples.</string></property><property name="enabled"><bool>false</bool></property></widget></item>
         </layout>
        </item>
        <item row="1" column="0"><widget class="QLabel" name="labelScale"><property name="text"><string>Scale:</string></property><property name="buddy"><cstring>spinScale</cstring></property></widget></item>
        <item row="1" column="1">
         <widget class="QDoubleSpinBox" name="spinScale">
          <property name="decimals"><number>9</number></property>
          <property name="minimum"><double>-1000000000.000000000000000</double></property>
          <property name="maximum"><double>1000000000.000000000000000</double></property>
          <property name="singleStep"><double>0.001000000000000</double></property>
          <property name="value"><double>1.000000000000000</double></property>
          <property name="suffix"><string> unit/code</string></property>
         </widget>
        </item>
        <item row="2" column="0"><widget class="QLabel" name="labelUnit"><property name="text"><string>Display unit:</string></property><property name="buddy"><cstring>comboUnit</cstring></property></widget></item>
        <item row="2" column="1">
         <widget class="QComboBox" name="comboUnit">
          <item><property name="text"><string>raw</string></property></item>
          <item><property name="text"><string>A</string></property></item>
          <item><property name="text"><string>mA</string></property></item>
          <item><property name="text"><string>uA</string></property></item>
          <item><property name="text"><string>nA</string></property></item>
          <item><property name="text"><string>pA</string></property></item>
         </widget>
        </item>
       </layout>
      </widget>
     </item>
     <item>
      <widget class="QGroupBox" name="groupReading">
       <property name="title"><string>Live current</string></property>
       <layout class="QFormLayout" name="formReading">
        <item row="0" column="0"><widget class="QLabel" name="labelCurrentKey"><property name="text"><string>Current:</string></property></widget></item>
        <item row="0" column="1">
         <widget class="QLabel" name="lblCurrent">
          <property name="font"><font><bold>true</bold></font></property>
          <property name="text"><string>—</string></property>
          <property name="textInteractionFlags"><set>Qt::TextSelectableByMouse</set></property>
         </widget>
        </item>
        <item row="1" column="0"><widget class="QLabel" name="labelRaw"><property name="text"><string>Raw IIR code:</string></property></widget></item>
        <item row="1" column="1"><widget class="QLabel" name="lblRaw"><property name="text"><string>—</string></property><property name="textInteractionFlags"><set>Qt::TextSelectableByMouse</set></property></widget></item>
        <item row="2" column="0"><widget class="QLabel" name="labelInterval"><property name="text"><string>Last screen interval:</string></property></widget></item>
        <item row="2" column="1"><widget class="QLabel" name="lblInterval"><property name="text"><string>—</string></property><property name="wordWrap"><bool>true</bool></property><property name="textInteractionFlags"><set>Qt::TextSelectableByMouse</set></property></widget></item>
        <item row="3" column="0"><widget class="QLabel" name="labelAcquisition"><property name="text"><string>Acquisition:</string></property></widget></item>
        <item row="3" column="1"><widget class="QLabel" name="lblAcquisition"><property name="text"><string>—</string></property><property name="wordWrap"><bool>true</bool></property><property name="textInteractionFlags"><set>Qt::TextSelectableByMouse</set></property></widget></item>
       </layout>
      </widget>
     </item>
     <item><spacer name="controlSpacer"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>0</height></size></property></spacer></item>
    </layout>
   </item>
   <item>
    <layout class="QVBoxLayout" name="plotLayout">
     <item><widget class="NLabPlotWidget" name="plotCurrent" native="true"/></item>
    </layout>
   </item>
  </layout>
 </widget>
